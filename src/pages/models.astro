---
import Layout from '../layouts/base.astro';
import { ModelsHealthPage } from '../components/model-health/ModelsHealthPage';
import FaqSection from '../components/FaqSection.astro';
import DataAttributionFooter from '../components/DataAttributionFooter.astro';
import { generateFAQSchema } from '../lib/seo';
import { modelHealthFaqs } from '../lib/model-health-faq';
---

<Layout
  title="Free Model Health - Free LLM Router"
  description="Browse health data for free OpenRouter models. Compare reliability, error rates, and community reports to find working free AI models."
  url="/models"
  jsonLd={generateFAQSchema(modelHealthFaqs)}
>
  <div class="container mx-auto max-w-5xl px-4 py-8">
    <ModelsHealthPage client:load />

    <FaqSection id="faq" faqs={modelHealthFaqs} class="mt-16" />

    <DataAttributionFooter class="mt-16 pt-8" />
  </div>
</Layout>
