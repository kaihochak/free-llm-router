---
import Layout from '../layouts/base.astro';
import { Badge } from '../components/ui/badge';
import { Button } from '../components/ui/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '../components/ui/card';
import { Input } from '../components/ui/input';
import { Separator } from '../components/ui/separator';
import { Textarea } from '../components/ui/textarea';
import { ArrowRight, Copy } from 'lucide-react';

const colors = [
  {
    name: 'Primary',
    token: '--primary',
    className: 'bg-primary',
    foreground: 'text-primary-foreground',
  },
  {
    name: 'Secondary',
    token: '--secondary',
    className: 'bg-secondary',
    foreground: 'text-secondary-foreground',
  },
  { name: 'Muted', token: '--muted', className: 'bg-muted', foreground: 'text-muted-foreground' },
  {
    name: 'Destructive',
    token: '--destructive',
    className: 'bg-destructive',
    foreground: 'text-white',
  },
  {
    name: 'Background',
    token: '--background',
    className: 'bg-background',
    foreground: 'text-foreground',
  },
  { name: 'Card', token: '--card', className: 'bg-card', foreground: 'text-card-foreground' },
];
---

<Layout
  title="Design System | Free LLM Router"
  description="Core visual tokens and interface components used by Free LLM Router."
>
  <div class="container mx-auto max-w-5xl px-4 sm:px-6">
    <main class="space-y-16 py-12 sm:py-16">
      <section>
        <div class="mb-6">
          <h2 class="type-title">Colors</h2>
          <p class="type-caption mt-1">Semantic tokens for light and dark themes.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            colors.map((color) => (
              <div class="overflow-hidden rounded-xl border bg-card">
                <div class:list={['flex h-24 items-end p-4', color.className, color.foreground]}>
                  <span class="type-label">Aa</span>
                </div>
                <div class="flex items-center justify-between gap-3 p-4">
                  <span class="type-label">{color.name}</span>
                  <code class="type-caption font-mono">{color.token}</code>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <div class="mb-6">
          <h2 class="type-title">Typography</h2>
          <p class="type-caption mt-1">Six reusable roles for the entire product.</p>
        </div>
        <div class="divide-y overflow-hidden rounded-xl border bg-card">
          <div class="grid gap-3 p-6 sm:grid-cols-[120px_1fr] sm:items-baseline">
            <code class="type-caption font-mono">type-display</code>
            <p class="type-display">Models that stay up.</p>
          </div>
          <div class="grid gap-3 p-6 sm:grid-cols-[120px_1fr] sm:items-baseline">
            <code class="type-caption font-mono">type-heading</code>
            <p class="type-heading">Reliable by default</p>
          </div>
          <div class="grid gap-3 p-6 sm:grid-cols-[120px_1fr] sm:items-baseline">
            <code class="type-caption font-mono">type-title</code>
            <p class="type-title">Model availability</p>
          </div>
          <div class="grid gap-3 p-6 sm:grid-cols-[120px_1fr] sm:items-baseline">
            <code class="type-caption font-mono">type-body</code>
            <p class="type-body">Find free models with live health and availability data.</p>
          </div>
          <div class="grid gap-3 p-6 sm:grid-cols-[120px_1fr] sm:items-baseline">
            <code class="type-caption font-mono">type-label</code>
            <p class="type-label">Context length</p>
          </div>
          <div class="grid gap-3 p-6 sm:grid-cols-[120px_1fr] sm:items-baseline">
            <code class="type-caption font-mono">type-caption</code>
            <p class="type-caption">Availability · Updated now</p>
          </div>
        </div>
      </section>

      <section>
        <div class="mb-6">
          <h2 class="type-title">Components</h2>
          <p class="type-caption mt-1">Common controls and states.</p>
        </div>
        <div class="grid gap-4">
          <div class="rounded-xl border bg-card p-6">
            <h3 class="type-label mb-5">Buttons</h3>
            <div class="flex flex-wrap items-center gap-3">
              <Button>Primary <ArrowRight /></Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="outline">Outline</Button>
              <Button variant="ghost">Ghost</Button>
              <Button variant="destructive">Destructive</Button>
              <Button variant="outline" size="icon" aria-label="Copy"><Copy /></Button>
              <Button disabled>Disabled</Button>
            </div>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="rounded-xl border bg-card p-6">
              <h3 class="type-label mb-5">Badges</h3>
              <div class="flex flex-wrap gap-2">
                <Badge>Available</Badge>
                <Badge variant="secondary">Free</Badge>
                <Badge variant="outline">128k context</Badge>
                <Badge variant="destructive">Offline</Badge>
              </div>
            </div>
            <div class="rounded-xl border bg-card p-6">
              <h3 class="type-label mb-5">Form controls</h3>
              <div class="space-y-3">
                <Input aria-label="Model name" placeholder="Search models…" />
                <Textarea
                  aria-label="Description"
                  placeholder="Description…"
                  className="min-h-20"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="mb-6">
          <h2 class="type-title">Example</h2>
          <p class="type-caption mt-1">The components in product context.</p>
        </div>
        <Card className="max-w-xl">
          <CardHeader>
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="mb-3 flex gap-2">
                  <Badge>Available</Badge>
                  <Badge variant="secondary">Free</Badge>
                </div>
                <CardTitle>DeepSeek R1</CardTitle>
                <CardDescription className="mt-1">deepseek/deepseek-r1:free</CardDescription>
              </div>
              <span class="mt-1 size-3 rounded-full bg-primary" aria-label="Online"></span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="grid grid-cols-3 gap-3">
              <div class="rounded-lg bg-muted p-3">
                <p class="type-caption text-muted-foreground">Uptime</p>
                <p class="type-label mt-1">99.8%</p>
              </div>
              <div class="rounded-lg bg-muted p-3">
                <p class="type-caption text-muted-foreground">Context</p>
                <p class="type-label mt-1">164k</p>
              </div>
              <div class="rounded-lg bg-muted p-3">
                <p class="type-caption text-muted-foreground">Latency</p>
                <p class="type-label mt-1">1.2s</p>
              </div>
            </div>
          </CardContent>
          <Separator />
          <CardFooter className="justify-between gap-3 pt-6">
            <Button variant="ghost">View details</Button>
            <Button>Use model <ArrowRight /></Button>
          </CardFooter>
        </Card>
      </section>
    </main>
  </div>
</Layout>
