---
import Layout from '../layouts/base.astro';
import { ModelsAvailabilityPage } from '../components/model-availability/ModelsAvailabilityPage';
import FaqSection from '../components/FaqSection.astro';
import DataAttributionFooter from '../components/DataAttributionFooter.astro';
import { generateFAQSchema } from '../lib/seo';
import { modelAvailabilityFaqs } from '../lib/model-availability-faq';
---

<Layout
  title="Free Model Availability - Free LLM Router"
  description="Track availability history for free OpenRouter models. Compare daily uptime trends and see which free models remain available over time."
  url="/availability"
  jsonLd={generateFAQSchema(modelAvailabilityFaqs)}
>
  <div class="container mx-auto max-w-5xl px-4 py-8">
    <ModelsAvailabilityPage client:load />

    <FaqSection id="faq" faqs={modelAvailabilityFaqs} class="mt-16" />

    <DataAttributionFooter class="mt-16 pt-8" />
  </div>
</Layout>
